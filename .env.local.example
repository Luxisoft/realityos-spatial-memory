# Windows + Docker Desktop. This file is a template; secrets belong in .env.local.
ENVIRONMENT=local
LOCAL_LOGIN_ENABLED=true
LOCAL_HTTP_PORT=8080
LOCAL_ACCOUNT_EMAIL=
LOCAL_ACCOUNT_PASSWORD=
LOCAL_ACCOUNT_NAME='Cuenta local'
POSTGRES_DB=realityos_local
POSTGRES_USER=realityos_local
POSTGRES_PASSWORD=
JWT_SECRET=
DEVICE_CREDENTIAL_PEPPER=
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
META_MODE=live
FACE_ENGINE=insightface
META_CONNECTION_MODE=direct
META_GATEWAY_FALLBACK_ENABLED=false
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_GATEWAY_BASE_URL=
META_GATEWAY_TOKEN=
META_TIMEOUT_SECONDS=30
META_VIDEO_TIMEOUT_SECONDS=600
META_MAX_RETRIES=2
TTS_SERVICE_URL=http://seamless-tts:8091/synthesize
TTS_SERVICE_TOKEN=
TTS_TIMEOUT_SECONDS=30
# auto uses native BF16 when supported, otherwise real FP32 inference.
TTS_DTYPE=auto
LOCAL_TTS_MEMORY=8g
VIRTUAL_DEVICE_BOOTSTRAP_ENABLED=false
ENQUEUE_PROCESSING=true
# Optional real Facebook integration; never required for local password entry.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
