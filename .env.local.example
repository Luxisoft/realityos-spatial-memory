# Localhost only: Windows / Linux x64, PostgreSQL, Redis, API and worker.
# Keep in sync with .env.example. The installer copies this file to .env.local.
# Supply your own MODEL_API_KEY in .env.local; never commit that private file.

# Local runtime and account selector.
ENVIRONMENT=local
LOCAL_LOGIN_ENABLED=true
LOCAL_EVALUATION_ENABLED=true
LOCAL_HTTP_PORT=8080

# Windows Android connection helper: scripts/local/Connect-Android.ps1.
# localhost keeps the existing USB/paired Wi-Fi ADB connection.
# hotspot uses the phone's shared network (initial USB setup required).
ANDROID_CONNECTION_MODE=localhost
ANDROID_HOTSPOT_PC_IP=10.108.140.109
ANDROID_ADB_PATH=C:\platform-tools\adb.exe

# Local database and internal secrets (generated by the installer).
POSTGRES_DB=realityos_local
POSTGRES_USER=realityos_local
POSTGRES_PASSWORD=
STORAGE_ENCRYPTION_KEY=
JWT_SECRET=
DEVICE_CREDENTIAL_PEPPER=

# Local API.
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Real processing. Meta requests go directly to its API and require internet.
META_MODE=live
FACE_ENGINE=insightface
META_CONNECTION_MODE=direct
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TIMEOUT_SECONDS=30
META_GROUNDING_TIMEOUT_SECONDS=300
META_VIDEO_TIMEOUT_SECONDS=600
META_MAX_RETRIES=2
ENQUEUE_PROCESSING=true
