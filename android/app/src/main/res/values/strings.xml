    <string name="intro_page_home_kicker">A HUMAN PROBLEM</string>
    <string name="intro_page_home_title">Give the world around you a memory.</string>
    <string name="intro_page_home_body">From finding the keys at home to recovering a tool at work, people lose time looking for things they already saw.</string>
    <string name="intro_page_work_kicker">THE COST OF FORGETTING</string>
    <string name="intro_page_work_title">A personal search becomes an operational cost.</string>
    <string name="intro_page_work_body">In workshops, warehouses, factories and stores, useful observations disappear between people and shifts. Inventory says what exists; it rarely shows where it was last seen.</string>
    <string name="intro_page_memory_kicker">THE REALITYOS MEMORY</string>
    <string name="intro_page_memory_title">Capture voluntarily. Preserve the evidence.</string>
    <string name="intro_page_memory_body">RealityOS transforms real photos and selected video moments into a shared memory of objects, locations, nearby context and observation history.</string>
    <string name="intro_page_shared_kicker">THE DIFFERENCE</string>
    <string name="intro_page_shared_title">Personal context becomes team knowledge.</string>
    <string name="intro_page_shared_body">Meta AI can help someone remember context. RealityOS lets a team retrieve what others observed, backed by the original photo and a “last seen” record.</string>
    <string name="intro_page_meta_kicker">POWERED BY META AI</string>
    <string name="intro_page_meta_title">Understand, locate and present real evidence.</string>
    <string name="intro_page_meta_body">Muse Spark understands visual evidence and natural-language questions. SAM 3.1 highlights a requested object when needed. Meta Wearables technology connects compatible glasses and Display experiences.</string>
    <string name="intro_page_future_kicker">LUXISOFT · HACKATHON 2026</string>
    <string name="intro_page_future_title">Don’t just see the world. Remember it.</string>
    <string name="intro_page_future_body">RealityOS builds a persistent spatial memory for homes today and operational teams tomorrow—one real observation at a time.</string>
