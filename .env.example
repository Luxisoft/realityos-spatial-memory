# Runtime
ENVIRONMENT=development
API_PREFIX=/v1
POSTGRES_DB=realityos
POSTGRES_USER=realityos
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_URL=postgresql+psycopg://realityos:realityos@postgres:5432/realityos
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-this-development-secret-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Capture limits
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=52428800
MAX_VIDEO_SECONDS=120

# Meta models
META_MODE=mock
# Used only for direct development calls. Production routes through META_GATEWAY_BASE_URL.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_GATEWAY_BASE_URL=
META_GATEWAY_TOKEN=
META_TIMEOUT_SECONDS=30
META_MAX_RETRIES=2
ENQUEUE_PROCESSING=true

# Demo only. Change or remove in production.
SEED_ADMIN_EMAIL=admin@realityos.local
SEED_ADMIN_PASSWORD=ChangeMeNow123!
